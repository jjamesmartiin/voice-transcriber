# ==============================================================================
# Voice Transcriber Configuration Example
# ==============================================================================
# Copy this file to 'config.yaml' (in root directory or config/ directory) to override defaults.
# Format: YAML
# NOTE: config.yaml is gitignored, so local secrets stay out of git.

# ------------------------------------------------------------------------------
# Audio Notification Mute Setting
# Controls whether audio cue sounds (pop/chime) play when transcription finishes.
# Available Options:
#   - true  : Audio cues muted (silent operation)
#   - false : Play audio cue sound on transcription complete
# Default: true
is_muted: true

# ------------------------------------------------------------------------------
# Auto-Typing Setting
# Controls whether transcription text is automatically typed into active window.
# Available Options:
#   - false : Clipboard only (copies text to clipboard, no auto-typing)
#   - true  : Auto-type (simulates keypresses into focused window)
# Default: true
#   (Derived from output_mode; the two are kept in sync automatically.)
auto_type: true

# ------------------------------------------------------------------------------
# Output Mode
# Controls output delivery method and typing speed.
# Available Options:
#   - "clipboard" : Copy text to clipboard only
#   - "type"      : Auto-type into focused window with safe 10ms key delay
#   - "type_fast" : Optimized auto-type with 1ms key delay and Unicode quote normalization
# Default: "type_fast"
output_mode: "type_fast"

# ------------------------------------------------------------------------------
# Auto-Type Trailing Space
# When auto-type / fast-type is active, controls whether a trailing space (' ') is
# appended after the text so multiple dictations chain together seamlessly.
# Available Options:
#   - true  : Append trailing space (' ')
#   - false : Do not append space (type exact transcription)
# Default: true
auto_type_trailing_space: true

# ------------------------------------------------------------------------------
# Auto-Type Full Punctuation Enforcement
# When auto-type / fast-type is active, controls whether punctuation is automatically
# set to full punctuation and terminal period enforced.
# Available Options:
#   - true  : Enforce full punctuation and terminal period on typed output
#   - false : Preserve user-selected punctuation mode (e.g. no_punctuation / no_terminal_period)
# Default: false
auto_type_auto_punctuate: false

# ------------------------------------------------------------------------------
# Clipboard Copy Setting
# Controls whether transcribed text is automatically placed in system clipboard.
# Available Options:
#   - true  : Automatically copy transcribed text to clipboard
#   - false : Do not copy transcribed text to clipboard
# Default: false
#   (Derived from output_mode; clipboard/type outputs set this automatically.)
copy_to_clipboard: false

# ------------------------------------------------------------------------------
# Mode Preset (Formatting & Capitalization Style)
# Controls grammar rules, casing, and punctuation styles for output.
# Selectable at runtime via 'Mode Preset' in the settings modal [s/S/,].
# Available Presets:
#   - "default"             : Standard capitalization, grammar, and full punctuation with terminal period.
#   - "casual"              : Standard capitalization and internal commas, but omits the trailing period.
#   - "autocorrect"         : Phone-style capitalization (sentence starts and capital 'I'), with all punctuation stripped.
#   - "aesthetic_lowercase" : All lowercase (even 'i'), but internal/expressive punctuation kept (no trailing period).
#   - "gen_z"               : Pure Gen Z mode: all lowercase, zero punctuation, zero grammar enforcement.
# (Backwards-compatible aliases: punctuation_mode: "full" | "no_terminal_period" | "no_punctuation" | "lowercase_no_punctuation")
# Default: "autocorrect"
preset: "autocorrect"

# ------------------------------------------------------------------------------
# Spoken Language Setting & Disclaimer
# Voice Transcriber is designed and optimized specifically for English ("en").
# The real-time post-processor (verbal retractions like "scratch that", stutter
# deduplication, filler-word stripping, number conversion, homophone repair, and
# casing) is written exclusively for English.
#
# Disclaimer: The underlying Cohere Transcribe model supports 14 languages:
#   ["en", "fr", "de", "es", "it", "pt", "nl", "pl", "el", "ar", "ja", "zh", "vi", "ko"]
# You can set a non-English language code here or via VT_LANGUAGE, but English is
# the primary officially supported language for the full post-processing pipeline.
# Default: "en"
language: "en"

# ------------------------------------------------------------------------------
# Small Language Model (SLM) Grammar & Polishing Pass (Optional)
# Enables an on-demand CPU Small Language Model pass (e.g. Qwen2.5-0.5B / SmolLM2-360M)
# to fix spelling and context grammar mistakes.
# Default: false (opt-in; requires a local vLLM/OpenAI-compatible endpoint)
enable_slm: false

# ------------------------------------------------------------------------------
# Wait for Model Warmup on Startup
# Ensures the model is 100% loaded and warmed up BEFORE activating hotkeys, so the
# user's very first dictation keypress is instantaneous without any cold-start delay.
# Default: true
wait_for_model_on_startup: true

# ------------------------------------------------------------------------------
# Number Words -> Digits Conversion
# Controls how spoken number words are transcribed. Toggleable at runtime in the
# settings modal ('Number Conversion').
# Available Options:
#   - auto   : Only runs of 2+ consecutive spoken digits become digits, so phone
#              numbers / serial numbers convert ("five five five one two" -> 55512)
#              while ordinals and small isolated counts read as words
#              ("the 5th item" -> "the fifth item", "I have 2 dogs" -> "I have two dogs").
#   - digits : Always convert ("twenty five" -> 25, "six seven zero" -> 670, "fifth" -> "5th").
#   - words  : Never convert number words; ordinal/small digits read as words.
# Legacy booleans are also accepted: true -> digits, false -> words.
# Default: auto
number_digits: auto

# ------------------------------------------------------------------------------
# Serial Numbers, Codes & NATO Phonetic Strings
# Detects alphanumeric identifiers, model/part/serial numbers, and NATO phonetic
# dictation, then writes them as a single token. Toggleable in settings [s/S/,].
# Available Options:
#   - true  : Collapse into one token ("A B C 1 2 3" -> ABC123, "Alpha Bravo 4" -> AB4)
#   - false : Keep single space separators ("A B C 1 2 3", "Alpha Bravo 4" -> A B 4)
# Recognized trigger nouns: serial (number), model (number), part (number), code,
# license (plate), vin (number), tracking (number).
# Example: "serial number X K 9 4 J" -> "serial number XK94J"
# Default: true
serial_collapse: true

# ------------------------------------------------------------------------------
# Verbal Spell Command
# Enables a spoken "spell" / "spelled" command that joins dictated letters,
# digits and NATO words. Toggleable in settings [s/S/,].
# Available Options:
#   - true  : "spell C A T" -> CAT, "the word is spelled c a t" -> "the word is spelled CAT"
#   - false : Leave "spell ..." phrases untouched
# Requires 2+ tokens (or a single NATO word) so "how do you spell accommodation" is untouched.
# Output follows the serial_collapse setting (collapsed by default).
# Default: true
spell_command: true

# ------------------------------------------------------------------------------
# Keep Bluetooth Hands-Free / Prevent Headphone Switching
# Prevents PipeWire / WirePlumber from automatically switching Bluetooth headsets
# between Headphone (A2DP) and Hands-Free (HFP/HSP) profiles when recording starts/stops.
# When enabled (true), keeping your headset on the Hands-Free option prevents background
# media/videos from pausing every time you record dictation.
# Available Options:
#   - true  : Keep Bluetooth in hands-free mode (prevents media pause on record end)
#   - false : Allow auto-switching back to headphone profile
# Default: true
keep_bluetooth_handsfree: true

# ------------------------------------------------------------------------------
# Middle-Click Push-to-Talk
# Tap the middle mouse button (< ~100ms) for a normal middle click; hold it
# (> ~100ms) to record. While enabled on Linux the hold is consumed (no
# primary-selection paste), and a left+right click within ~50ms is sent as Enter.
# Available Options:
#   - true  : Enable middle-click push-to-talk
#   - false : Disabled (opt-in feature)
# Default: false
middle_click_enabled: false

# ------------------------------------------------------------------------------
# Sound Theme
# Theme for audio feedback and completion cues.
# Available Options:
#   - "proximity" : Default subtle chime cue
#   - "pop"       : Pop sound cue
#   - "chime"     : Classic chime cue
#   - "silent"    : Mute all sounds (same as setting is_muted: true)
# Default: "proximity"
sound_theme: "proximity"

# ------------------------------------------------------------------------------
# UI Color Theme
# Accent color for the terminal UI (the ratatui frontend and the Rich fallback).
# Available Options:
#   - "auto"      : Follow the terminal/system accent color
#   - "green" | "cyan" | "blue" | "magenta" | "yellow" | "red" | "white"
# Default: "red"
#   (Also overrideable per-session with VT_UI_THEME or ACCENT_COLOR.)
ui_theme: "red"

# ------------------------------------------------------------------------------
# Average Typing Speed (Words Per Minute)
# Used to calculate estimated "Time Saved" compared to manual typing.
# Displayed in transcription badges, the session running total, and the
# all-time total persisted in <data dir>/stats.json across sessions.
# Default: 40
typing_wpm: 40

# ------------------------------------------------------------------------------
# Primary Audio Input Device Name
# Substring match for primary microphone device name.
# Available Options:
#   - null                 : Use system default microphone
#   - "Microphone Substring": Partial or full device name string (e.g. "USB Audio")
# Default: null
primary_device_name: null

# ------------------------------------------------------------------------------
# Secondary Audio Input Device Name
# Substring match for secondary/backup microphone device.
# Available Options:
#   - null                 : No secondary device specified
#   - "Microphone Substring": Partial or full secondary device name string
# Default: null
secondary_device_name: null

# ------------------------------------------------------------------------------
# Device Selection Override Mode
# Strategy used to pick between primary and secondary audio devices.
# Available Options:
#   - "auto"      : Try primary device first, fallback to secondary, fallback to default
#   - "primary"   : Force use of primary device only
#   - "secondary" : Force use of secondary device only
# Default: "auto"
override_mode: "auto"

# ------------------------------------------------------------------------------
# Custom Word & Phrase Dictionary Replacements
# High-speed Trie-compacted dictionary (~0.005 ms overhead) to convert spoken words
# or phrases into specific technical acronyms, symbols, or desired terms.
# Case-insensitive input matching; whole-word and multi-word boundary safe.
# Available Options:
#   - Map of "spoken phrase": "replacement phrase"
#   - null : No custom dictionary
# Default: null
dictionary:
  "pull request": "PR"
  "pr": "PR"
  "v l l m": "vLLM"
  "vllm": "vLLM"
  "vs code": "VS Code"
  "github": "GitHub"
  "gitea": "Gitea"
  "k8s": "Kubernetes"
  "deepseq": "Deepseek"
  "deep seq": "Deepseek"
  "deep seek": "Deepseek"
  "smiley face": "😊"

# ------------------------------------------------------------------------------
# External Dictionary File (optional)
# Path to an external YAML or JSON dictionary file (e.g. config/dictionary.yaml).
# If specified, takes precedence over the inline 'dictionary' setting above.
# Available Options:
#   - "path/to/file.yaml" or "path/to/file.json"
#   - null (use inline dictionary above)
# Default: null
dictionary_file: null
