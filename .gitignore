# Environments & build outputs
.env
.venv
env/
venv/
result
*.egg-info/

# Local model copies & release artifacts.
# Model weights are normally installed per-user (~/.local/share/vt/models/cohere)
# or shipped as GitHub Release assets, NOT committed to this repo.
/models/
/dist/

# PyInstaller scratch dir + generated spec (platforms/windows/build_offline.py)
/build/
/VoiceTranscriber.spec

# Root-level local config overrides (ignored so local edits aren't committed)
/config.json
/config.yaml
/config.yml
/audio_device_config.json

# Lifetime dictation stats (src/voice_transcriber/stats.py). They live in the
# per-user data dir (~/.local/share/vt/stats.json, %LOCALAPPDATA%\vt\stats.json)
# and are created there automatically on first launch, so they are never inside
# the repo by default. A VT_STATS_FILE override can move the file here, so keep
# the name ignored wherever it lands.
stats.json

__pycache__/
*.pyc
