# EditorConfig — https://editorconfig.org
# Matched automatically by most editors; keeps the tree consistent without a
# formatter fighting hand-aligned tables in the Nix and PowerShell sources.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,jsonl,toml,nix}]
indent_size = 2

[*.md]
# Trailing whitespace is a hard line break in Markdown; leave it alone.
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2
switch_case_indent = true

[Makefile]
indent_style = tab

[*.{ps1,psm1,bat,cmd}]
# PowerShell here-strings and Windows batch are CRLF-sensitive.
end_of_line = crlf
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf
